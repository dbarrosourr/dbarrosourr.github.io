---
import { getCv } from '../i18n/index.js';
import Section from './Section.astro';

const cv = getCv(Astro.currentLocale ?? 'es');
---

<Section id="experiencia" nav={cv.sections.experience.nav} title={cv.sections.experience.title}>
	{cv.experience.map((job) => (
		<article class="job" data-reveal>
			<header class="job-head">
				<h3 class="job-role">{job.role}</h3>
				<p class="job-meta">
					<span class="job-company">{job.company}</span>
					<span class="job-period">{job.period}</span>
				</p>
			</header>
			<p class="job-summary">{job.summary}</p>
			<ul class="job-achievements">
				{job.achievements.map((a) => <li>{a}</li>)}
			</ul>
		</article>
	))}
</Section>
