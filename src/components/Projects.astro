---
import { getCv, getUi } from '../i18n/index.js';
import Section from './Section.astro';

const locale = Astro.currentLocale ?? 'es';
const cv = getCv(locale);
const t = getUi(locale);
---

<Section id="proyectos" nav={cv.sections.projects.nav} title={cv.sections.projects.title}>
	{cv.projects.map((p) => (
		<article class="project" data-reveal>
			{p.images?.length && (
				<div class="project-media">
					{p.images.map((img) => (
						<div class="project-window">
							<div class="window-bar" aria-hidden="true">
								<span class="dot"></span>
								<span class="dot"></span>
								<span class="dot"></span>
								<span class="window-file">{img.split('/').pop()}</span>
							</div>
							<img
								src={import.meta.env.BASE_URL + img}
								alt={p.name}
								loading="lazy"
							/>
						</div>
					))}
				</div>
			)}
			<h3 class="project-name">{p.name}</h3>
			<p class="project-desc">{p.description}</p>
			<p class="project-stack" aria-label={t.projects.stack}>
				{p.stack.map((s) => <span class="chip">{s}</span>)}
			</p>
			<p class="project-result">
				<strong>{t.projects.result}:</strong> {p.result}
			</p>
		</article>
	))}
</Section>
