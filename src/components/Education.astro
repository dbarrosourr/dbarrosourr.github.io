---
import { cv } from '../data.js';
import Section from './Section.astro';
---

<Section id="educacion" nav="Educación" title="Educación y certificaciones">
	<div class="edu-grid">
		{cv.education.map((e) => (
			<div class="edu-item" data-reveal>
				<h3 class="edu-degree">{e.degree}</h3>
				<p class="edu-institution">
					{e.type} · {e.institution}
				</p>
				<p class="edu-period">{e.period}</p>
			</div>
		))}
		<div class="edu-item edu-item--certs" data-reveal>
			<h3 class="edu-degree">Certificaciones</h3>
			<ul class="cert-list">
				{cv.certifications.map((c) => (
					<li>
						<span class="cert-name">{c.name}</span><span class="cert-year">{c.year}</span>
					</li>
				))}
			</ul>
		</div>
	</div>
</Section>
