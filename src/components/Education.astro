---
import { getCv } from '../i18n/index.js';
import Section from './Section.astro';

const cv = getCv(Astro.currentLocale ?? 'es');
---

<Section id="educacion" nav={cv.sections.education.nav} title={cv.sections.education.title}>
	<div class="edu-grid">
		{cv.education.map((e) => (
			<div class="edu-item" data-reveal>
				<h3 class="edu-degree">{e.degree}</h3>
				<p class="edu-institution">
					{e.type} · {e.institution}
				</p>
				<p class="edu-period">{e.period}</p>
			</div>
		))}
	</div>
</Section>
