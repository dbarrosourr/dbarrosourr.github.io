---
import { getCv } from '../i18n/index.js';
import Section from './Section.astro';
import Icon from './Icon.astro';

const cv = getCv(Astro.currentLocale ?? 'es');
---

<Section id="certificaciones" nav={cv.sections.certifications.nav} title={cv.sections.certifications.title}>
	<ul class="cert-list" data-reveal>
		{cv.certifications.map((c) => (
			<li class="cert-item">
				{c.logo && (
					<img
						class="cert-logo"
						src={import.meta.env.BASE_URL + c.logo}
						alt={c.name}
						loading="lazy"
					/>
				)}
				<span class="cert-name">
					{c.url ? (
						<a class="cert-verify" href={c.url} target="_blank" rel="noopener noreferrer">
							{c.name}
							<Icon name="external" />
						</a>
					) : (
						c.name
					)}
				</span>
				<span class="cert-year">{c.year}</span>
			</li>
		))}
	</ul>
</Section>
