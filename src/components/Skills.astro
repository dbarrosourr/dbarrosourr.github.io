---
import { getCv } from '../i18n/index.js';
import Section from './Section.astro';

const cv = getCv(Astro.currentLocale ?? 'es');
---

<Section id="skills" nav={cv.sections.skills.nav} title={cv.sections.skills.title}>
	<div class="skills-grid">
		{cv.skills.map((g) => (
			<div class="skill-group" data-reveal>
				<h3 class="skill-category">{g.category}</h3>
				<ul class="skill-items">
					{g.items.map((s) => <li>{s}</li>)}
				</ul>
			</div>
		))}
	</div>
</Section>
